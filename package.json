{
  "name": "abyss-dashboard-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @lexmount.com/abyss-ui && npm run build -w @lexmount.com/abyss-dashboard",
    "check:dashboard-release": "node scripts/check-dashboard-release.mjs",
    "check:ui-release": "node scripts/check-ui-release.mjs",
    "dev": "npm run build -w @lexmount.com/abyss-ui && npm run dev -w @lexmount.com/abyss-dashboard",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts --max-warnings=0 && npm run lint --workspaces --if-present",
    "test": "npm run build -w @lexmount.com/abyss-ui && npm run test:release && npm run test --workspaces --if-present",
    "test:release": "node --test --test-concurrency=1 scripts/dashboard-package-blackbox.test.mjs scripts/dashboard-release-contract.test.mjs scripts/ui-release-contract.test.mjs scripts/ui-style-contract.test.mjs",
    "typecheck": "npm run build -w @lexmount.com/abyss-ui && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.51.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
