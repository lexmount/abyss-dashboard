{
  "name": "@lexmount.com/abyss-dashboard",
  "version": "0.1.0",
  "description": "Local web dashboard for the standalone Abyss event backend",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "bin": {
    "abyss-dashboard": "bin/abyss-dashboard.mjs"
  },
  "files": [
    "LICENSE",
    "bin",
    "dist",
    "server/cli.mjs",
    "server/config.mjs",
    "server/http.mjs",
    "server/proxy.mjs",
    "server/server.mjs",
    "server/static.mjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexmount/abyss-dashboard.git",
    "directory": "apps/dashboard"
  },
  "scripts": {
    "start": "node bin/abyss-dashboard.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && node --test server/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@lexmount.com/abyss-ui": "0.2.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.62.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.0",
    "recharts": "3.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
